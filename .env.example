# Copie este arquivo para .env.local e preencha os valores.

# Supabase > Project Settings > API (ou o botão "Connect" no topo do painel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAWG (https://rawg.io/apidocs). Só no servidor: NÃO usar o prefixo NEXT_PUBLIC_.
# Na Vercel, cadastrar como Secret.
RAWG_API_KEY=

# Steam Web API (https://steamcommunity.com/dev/apikey). Só no servidor.
# Na Vercel, cadastrar como Secret.
STEAM_API_KEY=

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...).
# Ignora a RLS: usada só no servidor (src/lib/supabase/admin.ts) para gravar
# o steam_id depois que a Steam confirma o login. NUNCA usar NEXT_PUBLIC_.
# Na Vercel, cadastrar como Secret.
SUPABASE_SECRET_KEY=
